{
  "manifest_version": 3,
  "name": "ScryBuy",
  "version": "2.2.0",
  "description": "Adds and hides purchase links on Scryfall",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://scrybuy-api.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scryfall.com/card/*",
        "https://scryfall.com/search*",
        "https://scryfall.com/sets/*"
      ],
      "js": ["contentScript.js"],
      "css": ["index.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ScryBuy",
    "default_area": "navbar",
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  }
}
